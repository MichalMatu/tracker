  "commands": [
    "set -eu; test \"$(git rev-parse HEAD)\" = \"e3b3ec837b9c78cc6b79b06f6d9e874faf6e0b01\"; SERIALS=$(adb devices | awk 'NR>1 && $2==\"device\" {print $1}'); COUNT=$(printf '%s\\n' \"$SERIALS\" | sed '/^$/d' | wc -l | tr -d ' '); test \"$COUNT\" = \"1\"; SERIAL=$(printf '%s\\n' \"$SERIALS\" | sed -n '1p'); adb -s \"$SERIAL\" shell monkey -p io.blueeye -c android.intent.category.LAUNCHER 1 >/dev/null; sleep 1; adb -s \"$SERIAL\" shell uiautomator dump /sdcard/t0-manual-flow.xml >/dev/null 2>&1 || true; if ! adb -s \"$SERIAL\" shell cat /sdcard/t0-manual-flow.xml 2>/dev/null | grep -q 'Telemetry &amp; AI Bridge'; then adb -s \"$SERIAL\" shell input tap 75 160; sleep 1; adb -s \"$SERIAL\" shell uiautomator dump /sdcard/t0-drawer.xml >/dev/null 2>&1 || true; B=$(adb -s \"$SERIAL\" shell cat /sdcard/t0-drawer.xml | python3 -c 'import sys,xml.etree.ElementTree as ET; r=ET.fromstring(sys.stdin.read()); n=next(x for x in r.iter() if x.attrib.get(\"text\")==\"Telemetry & AI Bridge\"); print(n.attrib[\"bounds\"])'); XY=$(printf '%s' \"$B\" | python3 -c 'import sys,re; a=list(map(int,re.findall(r\"\\d+\",sys.stdin.read()))); print((a[0]+a[2])//2,(a[1]+a[3])//2)'); set -- $XY; adb -s \"$SERIAL\" shell input tap \"$1\" \"$2\"; sleep 1; fi; adb -s \"$SERIAL\" shell uiautomator dump /sdcard/t0-manual-flow-final.xml >/dev/null 2>&1 || true; echo '--- current UI relevant lines ---'; adb -s \"$SERIAL\" shell cat /sdcard/t0-manual-flow-final.xml 2>/dev/null | sed 's/></>\\n</g' | grep -E 'Account|Drive file scope|Gmail send scope|Granted|T0 API test sent successfully|Last T0 test|Drive file|Drive file id|Gmail message id|bridge-test|meehow939' | head -260 || true; echo '--- all text values around Last T0 test ---'; adb -s \"$SERIAL\" shell cat /sdcard/t0-manual-flow-final.xml 2>/dev/null | python3 -c 'import sys,xml.etree.ElementTree as ET; r=ET.fromstring(sys.stdin.read()); vals=[n.attrib.get(\"text\",\"\") for n in r.iter() if n.attrib.get(\"text\")];
for i,v in enumerate(vals):
    if v==\"Last T0 test\":
        print("\\n".join(vals[i:i+12]))'"
  ]
}
